# syntax=docker/dockerfile:1
# Generic Dockerfile for Go binaries (operator, controlplane).
# Pass --build-arg BINARY=<cmd> to select which binary to build.

FROM golang:1.26-bookworm AS build

ARG BINARY
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -o /out/${BINARY} ./cmd/${BINARY}

FROM gcr.io/distroless/static-debian12
ARG BINARY
COPY --from=build /out/${BINARY} /app
ENTRYPOINT ["/app"]
